---
import { PROJECT_CODENAME, SITE_TITLE } from '../consts';
import { getForumCategories } from '../lib/forum';
import HeaderLink from './HeaderLink.astro';

const forumCategories = getForumCategories();
---

<header class="site-header">
	<nav class="container nav">
		<a class="brand" href="/">
			<span class="brand-name">{SITE_TITLE}</span>
			<span class="brand-code">{PROJECT_CODENAME}</span>
		</a>
		<div class="links">
			<HeaderLink href="/">首页</HeaderLink>
			{
				forumCategories.length > 0 ? (
					forumCategories.map((cat) => (
						<HeaderLink href={`/logs/c/${cat.id}/`}>{cat.name}</HeaderLink>
					))
				) : (
					<HeaderLink href="/logs/">日志</HeaderLink>
				)
			}
			<HeaderLink href="/about/">关于</HeaderLink>
			<HeaderLink href="/community/">社区</HeaderLink>
			<HeaderLink href="/download/">下载</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		backdrop-filter: blur(12px);
		background: rgba(238, 243, 247, 0.82);
		border-bottom: 1px solid var(--line);
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 4rem;
	}

	.brand {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: var(--ink);
		line-height: 1.1;
	}

	.brand-name {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.15rem;
		letter-spacing: -0.03em;
	}

	.brand-code {
		font-size: 0.72rem;
		color: var(--ink-soft);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: 0.15rem 0.85rem;
	}

	.links :global(a) {
		color: var(--ink-soft);
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 500;
		padding: 0.35rem 0;
		border-bottom: 2px solid transparent;
		transition:
			color 0.2s var(--ease),
			border-color 0.2s var(--ease);
	}

	.links :global(a:hover),
	.links :global(a.active) {
		color: var(--ink);
		border-bottom-color: var(--copper);
	}

	@media (max-width: 720px) {
		.nav {
			flex-direction: column;
			align-items: flex-start;
			padding-block: 0.85rem;
		}

		.links {
			justify-content: flex-start;
		}
	}
</style>
