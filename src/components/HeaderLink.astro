---
import type { HTMLAttributes } from 'astro/types';
import { normalizePathname } from '../lib/path';

type Props = HTMLAttributes<'a'> & {
	/** When set, overrides pathname-based active detection */
	active?: boolean;
};

const { href, class: className, active: activeProp, ...props } = Astro.props;
const normalized = normalizePathname(Astro.url.pathname);
const hrefPath =
	typeof href === 'string' ? normalizePathname(href.startsWith('http') ? new URL(href).pathname : href) : '/';
const autoActive =
	hrefPath === '/' ? normalized === '/' : normalized === hrefPath || normalized.startsWith(`${hrefPath}/`);
const isActive = typeof activeProp === 'boolean' ? activeProp : autoActive;
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
