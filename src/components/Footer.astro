---
import { BBS_URL } from '../consts';
import { getForumCategories, getSiteMeta } from '../lib/forum';

const year = new Date().getFullYear();
const meta = getSiteMeta();
const forumCategories = getForumCategories();
---

<footer class="site-footer">
	<div class="container footer-inner">
		<div>
			<p class="foot-brand">{meta.site_brand}</p>
			<p class="foot-meta">{meta.project_codename} · {meta.working_title_note}</p>
		</div>
		<div class="foot-links">
			{
				forumCategories.length > 0 ? (
					forumCategories.map((cat) => <a href={`/logs/c/${cat.id}/`}>{cat.name}</a>)
				) : (
					<a href="/logs/">日志</a>
				)
			}
			<a href={BBS_URL} target="_blank" rel="noopener noreferrer">{meta.forum_link_label}</a>
		</div>
		<p class="copy">© {year} {meta.site_brand}. {meta.footer_rights}</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		border-top: 1px solid var(--line);
		padding: 2.5rem 0 3rem;
		background: rgba(255, 255, 255, 0.35);
	}

	.footer-inner {
		display: grid;
		gap: 1.25rem;
	}

	.foot-brand {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.1rem;
		margin: 0;
	}

	.foot-meta {
		margin: 0.35rem 0 0;
		font-size: 0.85rem;
		color: var(--ink-soft);
	}

	.foot-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
	}

	.foot-links a {
		text-decoration: none;
		font-weight: 600;
		font-size: 0.92rem;
	}

	.copy {
		margin: 0;
		font-size: 0.8rem;
		color: var(--ink-soft);
	}
</style>
