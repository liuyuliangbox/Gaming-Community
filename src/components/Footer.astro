---
import { getSiteMeta } from '../lib/forum';

const year = new Date().getFullYear();
const meta = getSiteMeta();
const friendLinks = meta.friend_links;
---

<footer class="site-footer">
	<div class="container footer-inner">
		<div>
			<p class="foot-brand">{meta.site_brand}</p>
			<p class="foot-meta">{meta.project_codename} · {meta.working_title_note}</p>
		</div>
		{
			friendLinks.length > 0 ? (
				<div class="foot-links" aria-label="友链">
					{friendLinks.map((link) => (
						<a href={link.url} target="_blank" rel="noopener noreferrer">
							{link.label}
						</a>
					))}
				</div>
			) : null
		}
		<p class="copy">© {year} {meta.site_brand}. {meta.footer_rights}</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		border-top: 1px solid var(--line);
		padding: 2.5rem 0 3rem;
		background: rgba(255, 255, 255, 0.35);
	}

	.footer-inner {
		display: grid;
		gap: 1.25rem;
	}

	.foot-brand {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.1rem;
		margin: 0;
	}

	.foot-meta {
		margin: 0.35rem 0 0;
		font-size: 0.85rem;
		color: var(--ink-soft);
	}

	.foot-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
	}

	.foot-links a {
		text-decoration: underline;
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1px;
		font-weight: 600;
		font-size: 0.92rem;
		color: var(--copper);
	}

	.copy {
		margin: 0;
		font-size: 0.8rem;
		color: var(--ink-soft);
	}
</style>
