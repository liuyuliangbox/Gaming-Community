---
import {
	BBS_URL,
	PROJECT_CODENAME,
	SITE_TITLE,
	WORKING_TITLE_NOTE,
} from '../consts';
import { getForumCategories } from '../lib/forum';

const year = new Date().getFullYear();
const forumCategories = getForumCategories();
---

<footer class="site-footer">
	<div class="container footer-inner">
		<div>
			<p class="foot-brand">{SITE_TITLE}</p>
			<p class="foot-meta">{PROJECT_CODENAME} · {WORKING_TITLE_NOTE}</p>
		</div>
		<div class="foot-links">
			{
				forumCategories.length > 0 ? (
					forumCategories.map((cat) => <a href={`/logs/c/${cat.id}/`}>{cat.name}</a>)
				) : (
					<a href="/logs/">日志</a>
				)
			}
			<a href="/community/">社区规则</a>
			<a href={BBS_URL} target="_blank" rel="noopener noreferrer">bbs.aridjaya.eu.org</a>
		</div>
		<p class="copy">© {year} {SITE_TITLE}. 保留所有权利。</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		border-top: 1px solid var(--line);
		padding: 2.5rem 0 3rem;
		background: rgba(255, 255, 255, 0.35);
	}

	.footer-inner {
		display: grid;
		gap: 1.25rem;
	}

	.foot-brand {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.1rem;
		margin: 0;
	}

	.foot-meta {
		margin: 0.35rem 0 0;
		font-size: 0.85rem;
		color: var(--ink-soft);
	}

	.foot-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
	}

	.foot-links a {
		text-decoration: none;
		font-weight: 600;
		font-size: 0.92rem;
	}

	.copy {
		margin: 0;
		font-size: 0.8rem;
		color: var(--ink-soft);
	}
</style>
