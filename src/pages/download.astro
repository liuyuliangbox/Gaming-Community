---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BBS_URL, PROJECT_CODENAME, SITE_TITLE } from '../consts';
---

<BaseLayout title="下载" description={`${PROJECT_CODENAME} 下载与内测入口（尚未开放）`}>
	<main class="container page fade-up">
		<p class="eyebrow">下载</p>
		<h1>内测尚未开放</h1>
		<p class="lead">
			{SITE_TITLE} / {PROJECT_CODENAME} 仍在开发中。公开试玩包与内测资格会通过开发日志与社区通知发布。
		</p>

		<div class="panel">
			<p>想第一时间知道开放消息？</p>
			<ul>
				<li>关注 <a href="/logs/">开发日志</a></li>
				<li>
					加入
					<a href={BBS_URL} target="_blank" rel="noopener noreferrer"
						>bbs.aridjaya.eu.org</a
					>
					的「闲聊 / 招募测试」分类
				</li>
			</ul>
		</div>
	</main>
</BaseLayout>

<style>
	.page {
		padding: 3rem 0 4rem;
		max-width: 42rem;
	}

	.eyebrow {
		margin: 0 0 0.5rem;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--copper);
		font-weight: 600;
	}

	h1 {
		font-size: clamp(2rem, 5vw, 2.8rem);
		margin-bottom: 1rem;
	}

	.lead {
		font-size: 1.1rem;
		margin-bottom: 2rem;
	}

	.panel {
		padding: 1.5rem 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	ul {
		padding-left: 1.2rem;
		color: var(--ink-soft);
	}

	li {
		margin-bottom: 0.45rem;
	}
</style>
