---
import LogPostDetail from '../../components/LogPostDetail.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getForumPost, getForumPostIndex } from '../../lib/forum';

export function getStaticPaths() {
	return getForumPostIndex().map((post) => ({
		params: { id: String(post.id) },
	}));
}

const { id } = Astro.params;
const post = getForumPost(id!);
if (!post) {
	return Astro.redirect('/logs/');
}
---

<BaseLayout title={post.title} description={post.summary || post.title}>
	<main class="container log-main">
		<LogPostDetail post={post} />
	</main>
</BaseLayout>

<style>
	.log-main {
		padding: 2.5rem 0 4rem;
	}
</style>
