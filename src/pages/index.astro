---
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BBS_URL } from '../consts';
import { getForumCategories, getForumPostIndex, getSiteMeta, parseForumDate } from '../lib/forum';

const meta = getSiteMeta();
const categories = getForumCategories();
const primaryCat = categories[0];
const primaryName = primaryCat?.name || '日志';
const primaryHref = primaryCat ? `/logs/c/${primaryCat.id}/` : '/logs/';
const posts = getForumPostIndex().slice(0, 3);
---

<BaseLayout title={meta.site_brand} description={meta.site_description}>
	<section class="hero">
		<div class="hero-plane" aria-hidden="true"></div>
		<div class="container hero-inner">
			<p class="studio fade-up">{meta.site_brand}</p>
			<h1 class="codename fade-up-delay">{meta.project_codename}</h1>
			<p class="tagline fade-up-delay-2">{meta.working_title_note}</p>
			<div class="cta fade-up-delay-2">
				<a class="btn btn-primary" href={primaryHref}>阅读{primaryName}</a>
				<a
					class="btn btn-ghost"
					href={BBS_URL}
					target="_blank"
					rel="noopener noreferrer">加入讨论</a
				>
			</div>
		</div>
	</section>

	<section class="container section latest">
		<div class="section-head">
			<h2>最新{primaryName}</h2>
			<a href={primaryHref}>查看全部</a>
		</div>
		{
			posts.length === 0 ? (
				<p class="empty">同步后将在此展示社区「官网展示」栏目中的最新帖子。</p>
			) : (
				<ul class="log-list">
					{posts.map((post) => (
						<li>
							<p class="meta">
								<FormattedDate date={parseForumDate(post.created_at)} />
								{post.author_name ? <> · {post.author_name}</> : null}
							</p>
							<a href={`/logs/${post.id}/`}>
								{post.cover_url ? (
									<img
										class="cover"
										src={post.cover_url}
										alt=""
										loading="lazy"
										referrerpolicy="no-referrer"
									/>
								) : (
									<span class="cover cover-empty" aria-hidden="true" />
								)}
								<span class="body">
									<span class="title">{post.title}</span>
									{post.summary ? <span class="summary">{post.summary}</span> : null}
								</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		min-height: min(92vh, 52rem);
		display: grid;
		align-items: end;
		overflow: hidden;
		isolation: isolate;
	}

	.hero-plane {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(180deg, rgba(21, 32, 43, 0.08) 0%, rgba(21, 32, 43, 0.55) 100%),
			radial-gradient(ellipse 80% 60% at 70% 30%, rgba(42, 107, 114, 0.45), transparent 55%),
			radial-gradient(ellipse 70% 50% at 20% 70%, rgba(184, 90, 42, 0.28), transparent 50%),
			linear-gradient(135deg, #1c2a38 0%, #243b4a 45%, #3a2a22 100%);
		animation: planeShift 18s ease-in-out infinite alternate;
	}

	.hero-plane::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
		background-size: 56px 56px;
		opacity: 0.35;
		mask-image: linear-gradient(180deg, #000 20%, transparent 90%);
	}

	@keyframes planeShift {
		from {
			filter: saturate(1) hue-rotate(0deg);
			transform: scale(1);
		}
		to {
			filter: saturate(1.08) hue-rotate(6deg);
			transform: scale(1.03);
		}
	}

	.hero-inner {
		padding: 6rem 0 4.5rem;
		color: #f4f7fa;
	}

	.studio {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: clamp(2.4rem, 8vw, 5.2rem);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 0.95;
		color: #fff;
		text-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
	}

	.codename {
		margin: 0 0 1rem;
		font-size: clamp(1.25rem, 3vw, 1.85rem);
		font-weight: 600;
		color: rgba(255, 247, 240, 0.9);
	}

	.tagline {
		max-width: 28rem;
		margin-bottom: 1.75rem;
		color: rgba(238, 243, 247, 0.88);
		font-size: 1.08rem;
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.note {
		margin-top: 1.25rem;
		font-size: 0.85rem;
		color: rgba(238, 243, 247, 0.65);
	}

	.section {
		padding: 3.5rem 0 2rem;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.section-head h2 {
		font-size: 1.6rem;
	}

	.section-head a {
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
	}

	.empty {
		color: var(--ink-soft);
	}

	.log-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
	}

	.log-list li {
		padding-top: 0.85rem;
	}

	.log-list li + li {
		margin-top: 0.35rem;
	}

	.meta {
		margin: 0 0 0.55rem;
		font-size: 0.9rem;
		color: var(--ink-soft);
		text-align: left;
	}

	.log-list a {
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		gap: 0.85rem 1.25rem;
		align-items: start;
		padding: 1rem 0 1.15rem;
		border-top: 1px solid var(--line);
		text-decoration: none;
		color: inherit;
		transition: padding-left 0.25s var(--ease);
	}

	.log-list a:hover {
		padding-left: 0.35rem;
	}

	.cover {
		width: 7.5rem;
		height: 5.25rem;
		object-fit: cover;
		border-radius: 0.45rem;
		background: rgba(28, 42, 56, 0.08);
	}

	.cover-empty {
		display: block;
		background:
			linear-gradient(135deg, rgba(42, 107, 114, 0.18), rgba(184, 90, 42, 0.12)),
			rgba(28, 42, 56, 0.06);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
		padding-top: 0.15rem;
	}

	.title {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--ink);
		line-height: 1.3;
	}

	.summary {
		color: var(--ink-soft);
		font-size: 0.95rem;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (max-width: 720px) {
		.hero-inner {
			padding-top: 4.5rem;
		}

		.log-list a {
			grid-template-columns: 5.5rem 1fr;
			gap: 0.75rem 0.9rem;
		}

		.cover {
			width: 5.5rem;
			height: 4rem;
		}
	}
</style>
